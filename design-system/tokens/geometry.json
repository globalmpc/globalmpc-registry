{
  "$description": "A deliberately tight radius scale for rectangles. The ceiling is 10px: the visual language is drawn with rules and hairlines. Circles by meaning stay circles (see content/patterns.json).",
  "radius": {
    "radius-sm": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Badges, tags, inline chips.",
      "$extensions": {
        "mpc.group": "geometry",
        "mpc.use": {
          "en": "Badges, tags, inline chips."
        }
      }
    },
    "radius-md": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Buttons and inputs. The default.",
      "$extensions": {
        "mpc.group": "geometry",
        "mpc.use": {
          "en": "Buttons and inputs. The default."
        }
      }
    },
    "radius-lg": {
      "$value": "6px",
      "$type": "dimension",
      "$description": "Cards and panels.",
      "$extensions": {
        "mpc.group": "geometry",
        "mpc.use": {
          "en": "Cards and panels."
        }
      }
    },
    "radius-xl": {
      "$value": "10px",
      "$type": "dimension",
      "$description": "Dialogs and sheets. The ceiling for rectangles.",
      "$extensions": {
        "mpc.group": "geometry",
        "mpc.use": {
          "en": "Dialogs and sheets. The ceiling for rectangles."
        }
      }
    },
    "radius": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Base radius consumed by shadcn primitives.",
      "$extensions": {
        "mpc.group": "geometry",
        "mpc.use": {
          "en": "Base radius consumed by shadcn primitives."
        }
      }
    }
  }
}
