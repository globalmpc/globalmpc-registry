{
  "$schema": "https://json.schemastore.org/tsconfig",

  // 솔루션 파일이다. 자기 소스는 없고 하위 프로젝트만 모은다.
  //
  // `tsc --build`가 여기를 진입점으로 삼는다. 이 파일이 없으면 루트의
  // `pnpm typecheck`가 tsconfig.json을 못 찾아 실패한다 — 패키지별로 따로 돌리는
  // 방법은 있었지만 그 목록이 CI에만 있어서 루트 스크립트와 갈렸다.
  //
  // `apps/web`은 여기 없다. Next의 생성 타입(`next typegen`)이 있어야 검사가
  // 성립하므로 `@mpc/web`의 자체 typecheck 스크립트가 맡는다. 루트 스크립트가
  // 둘을 이어 부른다.
  "files": [],
  "references": [
    { "path": "./packages/canonical" },
    { "path": "./packages/domain" },
    { "path": "./packages/policy" },
    { "path": "./packages/db" },
    { "path": "./packages/api-contract" },
    { "path": "./packages/ui" },
    { "path": "./packages/config" },
    { "path": "./packages/storage" },
    { "path": "./apps/api" },
    { "path": "./apps/worker" }
  ]
}
