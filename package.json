{
  "name": "mpc-dapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --mode unit",
    "test:integration": "vitest run --mode integration",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force --noEmit && pnpm --filter @mpc/web typecheck",
    "build:openapi": "pnpm --filter @mpc/api-contract build",
    "check:openapi": "pnpm build:openapi && git diff --exit-code -- packages/api-contract/openapi.json",
    "check:contracts": "cd contracts && forge test",
    "check:brand": "node --test scripts/brand-tooling.test.mjs && tsx scripts/check-brand-assets.ts",
    "check:migration-rollback": "pnpm --filter @mpc/db rollback-check",
    "check": "pnpm typecheck && pnpm test && pnpm check:openapi && pnpm check:brand",
    "test:coverage": "node --test scripts/coverage-temp.test.mjs && node --import ./scripts/coverage-temp.mjs ./node_modules/vitest/vitest.mjs run --coverage"
  },
  "devDependencies": {
    "@mpc/api-contract": "workspace:*",
    "@mpc/ui": "workspace:*",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
