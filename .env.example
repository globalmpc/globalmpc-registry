# 환경변수 예시. 복사해서 `.env`로 쓴다 — `.env`는 커밋되지 않는다.
#
# **값이 아니라 참조를 넣을 수 있다.** `file:/run/secrets/x`는 파일에서,
# `env:OTHER_VAR`는 다른 환경변수에서 읽는다(`packages/config`). 배포에서는
# 참조를 쓴다 — 그러면 프로세스 환경과 `docker inspect`에 비밀이 남지 않는다.
#
# 로컬 스택은 `docker compose up -d`가 `deploy/local-secrets/`를 마운트하므로
# 이 파일 없이도 뜬다. 여기 있는 것은 직접 프로세스를 띄울 때의 목록이다.

# --- 필수 -----------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mpc_dev
SESSION_SECRET=local-development-session-secret-32chars

# SIWE 서명 도메인. 브라우저가 보는 주소와 같아야 한다.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# --- 체인 -----------------------------------------------------------------
CHAIN_ID=97
CHAIN_RPC_URL=http://localhost:8545
ANCHOR_CONTRACT_ADDRESS=
# **기본값이 없다.** 비우고 anchor worker를 띄우면 기동을 거절한다 — 손실 상한을
# 아무도 정하지 않은 채 배포되는 것을 막는다. 산정 공식은 `deploy/README.md`.
ANCHOR_DAILY_SPEND_CAP_WEI=
ANCHOR_SIGNER_PRIVATE_KEY=file:/run/secrets/anchor_signer_key
ANCHOR_CONFIRMATIONS=2
ANCHOR_FEE_CAP_GWEI=100
ANCHOR_MAX_ATTEMPTS=3
ANCHOR_POLL_MS=2000
ANCHOR_RECHECK_MS=5000
# EOA 제출을 허용할 chain id 목록. 여기 없는 체인은 multisig 제안 경로만 쓴다.
ANCHOR_EOA_CHAIN_IDS=31337,97
ANCHOR_SAFE_ADDRESS=
SAFE_SERVICE_URL=

# 거버넌스 무게의 출처. 비우면 수동 무게로 떨어지고 응답이 그 사실을 밝힌다.
GOVERNANCE_TOKEN_ADDRESS=
GOVERNANCE_CONFIRMATIONS=2

# --- 객체 저장 -------------------------------------------------------------
OBJECT_STORE=s3
OBJECT_ENDPOINT=http://localhost:9000
OBJECT_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_BUCKET=mpc-artifacts
OBJECT_ACCESS_KEY_ID=minioadmin
OBJECT_SECRET_ACCESS_KEY=file:/run/secrets/object_secret_key
OBJECT_FORCE_PATH_STYLE=true
# **기본값을 두지 않는다.** 저장 리전은 데이터 관할(OD-17)에 걸려 있다.
OBJECT_REGION=
# `none`은 NODE_ENV=production에서 거절된다. 관리형 S3에서는 `aes256`·`kms`.
OBJECT_SSE=none
OBJECT_KMS_KEY_ID=

# --- 서버 -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
REQUEST_TIMEOUT_MS=30000
SOCKET_IDLE_TIMEOUT_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# 프록시 홉 수는 **배포 환경의 사실**이다. 코드가 알 수 없다. 작게 잡으면 요청자가
# 컨테이너 사설 주소로 판정되어 무인증 경로의 상한이 사이트 전체 합산이 된다.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=
