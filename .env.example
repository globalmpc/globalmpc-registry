# Environment variable example. Copy it to `.env` — `.env` is not committed.
#
# Direct values are supported. Optional `file:/path` and `env:OTHER_VAR` references
# are resolved by packages/config when a platform chooses those injection formats.
#
# These settings start processes directly on the host. Compose has its own local defaults
# and does not mount config/local-secrets/. Use a separate Compose --env-file with
# container-network addresses rather than reusing this host-process example.

# --- Required -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mpc_dev
SESSION_SECRET=local-development-session-secret-32chars

# SIWE signing domain. Must match the address the browser sees.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

# --- Chain ----------------------------------------------------------------
# 56 (BSC mainnet), 5611 (opBNB testnet, dev deployment) or 31337 (local chain). Any other id
# refuses startup. opBNB testnet settings: `docs/operations/deployment.md`.
CHAIN_ID=31337
CHAIN_RPC_URL=http://localhost:8545
ANCHOR_CONTRACT_ADDRESS=
# **No default.** Starting the anchor worker with this empty is refused — it prevents deploying
# with nobody having set the loss cap. The sizing formula is in `docs/operations/deployment.md`.
ANCHOR_DAILY_SPEND_CAP_WEI=
# Public Anvil default account 0; accepted only with CHAIN_ID=31337. Every other chain refuses
# the anvil/hardhat default keys and every committed fixture key at startup — generate a fresh
# key there.
ANCHOR_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# 2 is for local anvil only. Shared chains (5611, 56) use the default 12 — staging must match
# production so reorg handling is exercised (docs/security/threat-model.md, T8).
ANCHOR_CONFIRMATIONS=2
# A receipt's block must also be at or below this node block tag before it is confirmed:
# safe | finalized | none. Unset: safe on 5611 and 56 (12 blocks are 3 s on opBNB), none on 31337
# (anvil's safe head trails 32 blocks). Any other value refuses startup.
ANCHOR_FINALITY_TAG=
# Blocks searched back for a batch's RootSubmitted log when its hash is unknown. Unset: a day of the
# chain's blocks (345600 on opBNB, 192000 on BSC, 86400 on anvil).
ANCHOR_LOG_LOOKBACK_BLOCKS=
# When that search fails (RPC error, rate limit), the row waits this long before it is tried again
# (unset: 60000) and goes to reconciliation_required as chain_search_unavailable once searches have
# failed for this long (unset: 3600000).
ANCHOR_CHAIN_SEARCH_RETRY_MS=
ANCHOR_CHAIN_SEARCH_GIVE_UP_MS=
ANCHOR_FEE_CAP_GWEI=100
ANCHOR_MAX_ATTEMPTS=3
# Gas limit on every anchor send. The daily cap reserves gas limit × fee cap for each send still
# waiting for its receipt — plus, on opBNB, twice the quoted L1 data fee. Default 200000.
ANCHOR_GAS_LIMIT=200000
ANCHOR_POLL_MS=2000
ANCHOR_RECHECK_MS=5000
# Chain ids allowed for EOA submission. Only the local chain 31337 and the opBNB testnet 5611 may
# be listed; 56 or any other id refuses startup. 5611 signs alone only when listed here, so the
# default stays 31337. Chains not listed use only the multisig proposal path.
ANCHOR_EOA_CHAIN_IDS=31337
ANCHOR_SAFE_ADDRESS=
SAFE_SERVICE_URL=

# Source of governance weight. If empty, falls back to manual weight and responses say so.
GOVERNANCE_TOKEN_ADDRESS=
GOVERNANCE_CONFIRMATIONS=2

# --- Object storage -------------------------------------------------------
OBJECT_STORE=s3
OBJECT_ENDPOINT=http://localhost:9000
OBJECT_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_BUCKET=mpc-artifacts
# Local Compose also uses these two as the MinIO root credentials and embeds them in the
# bucket-init URL: MinIO needs a key of at least 3 and a secret of at least 8 characters, and
# both must be URL-safe (avoid `@`, `:`, `/`, `%` and `#`).
OBJECT_ACCESS_KEY_ID=minioadmin
OBJECT_SECRET_ACCESS_KEY=minioadmin
OBJECT_FORCE_PATH_STYLE=true
# **No default.** The storage region is tied to data jurisdiction (OD-17).
OBJECT_REGION=
# `none` is rejected under NODE_ENV=production. Managed S3 uses `aes256` or `kms`.
OBJECT_SSE=none
OBJECT_KMS_KEY_ID=

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
REQUEST_TIMEOUT_MS=30000
SOCKET_IDLE_TIMEOUT_MS=60000
RATE_LIMIT_MAX=300
# Separate pool for /api/v1/public/*. Empty uses RATE_LIMIT_MAX.
PUBLIC_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=10
# The proxy hop count is **a fact of the deployment environment**; code cannot know it. Set
# too low, requesters resolve to the container's private address and the unauthenticated-path limit becomes a site-wide total.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=
# Edge proxy path — web app on a CDN, API elsewhere (`docs/operations/deployment.md`). All three are optional;
# unset keeps the same-network layout above.
# Same value on the web side (`EDGE_PROXY_SECRET` in the web app's environment). At least 32 chars.
EDGE_PROXY_SECRET=
# The web app's public origin, allowed to call the streaming upload route directly.
EDGE_WEB_ORIGIN=
# Peers that may read /health/* and /metrics. Default: private ranges. Others get 404.
OPS_ENDPOINT_CIDRS=

# --- File scanning --------------------------------------------------------
# Compose connects scan-worker to the separate clamav service over a private scan network.
# Direct process execution defaults to a local daemon.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
