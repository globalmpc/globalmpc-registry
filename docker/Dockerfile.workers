# Independent worker image. Build context is the repository root.
# WORKER must be jobs-worker, anchor-worker, or scan-worker.
# Keep the default final-stage reference valid; Compose explicitly selects each worker.
ARG WORKER=jobs-worker
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS dependencies
WORKDIR /repo
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable pnpm && corepack prepare pnpm@10.33.0 --activate
COPY . .
# COPY keeps host file modes; a checkout under umask 077 would leave the deployed tree unreadable
# by `mpc`. Normalize before deploy (docker/Dockerfile explains the same step).
RUN chmod -R a+rX,go-w .
ARG WORKER
RUN case "$WORKER" in jobs-worker|anchor-worker|scan-worker) ;; *) exit 1 ;; esac
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@mpc/${WORKER}..." --prod
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter "@mpc/${WORKER}" deploy --prod --legacy /worker
# viem/abitype/ox list `typescript` as an optional peer, so the deploy carries the TypeScript 7
# native compiler (a Go binary with its own CVEs) although nothing at run time uses it — tsx
# transpiles without it. Remove it and every link left dangling, then prove both are gone.
RUN rm -rf /worker/node_modules/.pnpm/typescript@* /worker/node_modules/.pnpm/@typescript+typescript-* \
    && node -e ' \
      const fs = require("node:fs"), path = require("node:path"); \
      const walk = (dir) => { for (const entry of fs.readdirSync(dir, { withFileTypes: true })) { \
        const full = path.join(dir, entry.name); \
        if (entry.isSymbolicLink()) { if (!fs.existsSync(full)) fs.unlinkSync(full); } \
        else if (entry.isDirectory()) walk(full); } }; \
      walk("/worker/node_modules"); \
      for (const name of fs.readdirSync("/worker/node_modules/.pnpm")) \
        if (/^(typescript@|@typescript\+typescript-)/.test(name)) throw new Error("TypeScript retained: " + name); \
      try { require.resolve("typescript", { paths: ["/worker"] }); throw new Error("typescript still resolves"); } \
      catch (error) { if (error.code !== "MODULE_NOT_FOUND") throw error; }'

FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS runtime
WORKDIR /app
ENV NODE_ENV=production
# Workers run `node` directly, so every package manager (npm, npx, yarn, corepack) is removed.
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
      /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-v* \
    && addgroup -S -g 10001 mpc \
    && adduser -S -D -H -u 10001 -G mpc -h /app -s /sbin/nologin mpc
COPY --from=dependencies /worker /app
USER mpc
CMD ["node", "node_modules/tsx/dist/cli.mjs", "src/main.ts"]

# All workers use the same minimal runtime; ClamAV has a separate secret-free image.
FROM runtime AS jobs-worker
FROM runtime AS anchor-worker
FROM runtime AS scan-worker

FROM ${WORKER} AS final
