# Independent worker image. Build context is the repository root.
# WORKER must be jobs-worker, anchor-worker, or scan-worker.
# Keep the default final-stage reference valid; Compose explicitly selects each worker.
ARG WORKER=jobs-worker
FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS dependencies
WORKDIR /repo
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
ARG WORKER
RUN case "$WORKER" in jobs-worker|anchor-worker|scan-worker) ;; *) exit 1 ;; esac
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@mpc/${WORKER}..." --prod
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter "@mpc/${WORKER}" deploy --prod --legacy /worker

FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN groupadd --system --gid 10001 mpc \
    && useradd --system --uid 10001 --gid mpc --home /app mpc
COPY --from=dependencies /worker /app
USER mpc
CMD ["node", "node_modules/tsx/dist/cli.mjs", "src/main.ts"]

# All workers use the same minimal runtime; ClamAV has a separate secret-free image.
FROM runtime AS jobs-worker
FROM runtime AS anchor-worker
FROM runtime AS scan-worker

FROM ${WORKER} AS final
