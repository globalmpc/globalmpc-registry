# Dedicated antivirus image. Never copy application code or mount application secrets here.
# Reuse the verified, digest-pinned Debian base already used by the application images.
FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
RUN groupadd --system --gid 10001 mpc \
    && useradd --system --uid 10001 --gid mpc --home /var/lib/clamav mpc \
    && sed -i 's/Components: main/Components: main non-free/' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clamav-daemon clamav-freshclam clamdscan libclamunrar \
    && sed -i \
      -e '\|^mozilla/emSign_ECC_Root_CA_-_G3\.crt$|s|^|!|' \
      -e '\|^mozilla/emSign_Root_CA_-_C1\.crt$|s|^|!|' \
      -e '\|^mozilla/emSign_ECC_Root_CA_-_C3\.crt$|s|^|!|' \
      /etc/ca-certificates.conf \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/clamav /var/tmp/clamav \
    && chown -R mpc:mpc /var/lib/clamav /var/tmp/clamav \
    && chmod 700 /var/tmp/clamav
COPY --chmod=644 docker/clamav/clamd.conf docker/clamav/freshclam.conf /etc/clamav/
COPY --chmod=755 docker/clamav/entrypoint.sh docker/clamav/healthcheck.sh /usr/local/bin/
USER mpc
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
