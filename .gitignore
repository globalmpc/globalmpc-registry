# macOS
.DS_Store
._*

# Editor
.vscode/
.idea/

node_modules/
dist/
*.tsbuildinfo
coverage/

# Next.js 빌드 산출물과 Playwright 실행 흔적
.next/
playwright-report/
test-results/

contracts/out/
contracts/cache/
contracts/broadcast/

# 환경 파일. 예시만 커밋한다.
.env
.env.*
!.env.example

# 실제 시크릿은 저장소에 들어가지 않는다. deploy/local-secrets/는 anvil·MinIO
# 기본값뿐이라 예외이며, 그 사실이 같은 디렉터리의 README에 적혀 있다.
deploy/secrets/
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
!deploy/local-secrets/*

# design-system/dist는 커밋된 산출물이다. `@mpc/design`의 exports가 가리키므로
# 빠지면 웹 빌드가 `@mpc/design/tokens.css`를 찾지 못한다.
!design-system/dist/
